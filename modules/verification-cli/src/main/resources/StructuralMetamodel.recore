import ecore : 'http://www.eclipse.org/emf/2002/Ecore';

package structural_metamodel : sm = 'http://example.com/structural_metamodel'
{
    enum Visibility { literal Pub = 0; literal Priv = 1; literal Prot = 2; literal Pkg = 3; }
    enum YesNo { literal Yes = 0; literal No = 1; }
    enum Scope { literal Instance = 0; literal Static = 1; }

    class Method
    {
        attribute mid : String {id};
        attribute memberName : String;
        attribute returnType : String;
        attribute paramTypes : String;
        attribute visibility : Visibility;
        attribute scope : Scope;
        attribute isAbstract : YesNo;
    }

    class Attribute
    {
        attribute aid : String {id};
        attribute memberName : String;
        attribute type : String;
        attribute visibility : Visibility;
        attribute scope : Scope;
    }

    class MethodBody;

    class ImplementationBinding
    {
        property implementer : Classifier;
        property target : Method;
        property body : MethodBody;
    }

    class Classifier
    {
        attribute cid : String {id};
        attribute name : String;
        attribute isAbstract : YesNo;
        property classParent : Classifier;
        property localMethods : Method[*] {composes};
        property localAttributes : Attribute[*] {composes};
        property inheritedMethods : Method[*];
        property inheritedAttributes : Attribute[*];
        property directInstances : Object[*];
    }

    class Object { attribute oid : String {id}; }

    class Root
    {
        property contents : Classifier[*] {composes};
    }

    -- O-01: Identifier Integrity (metamodel.als: IdentifierIntegrity)
    invariant UniqueCids : all c1, c2 : Classifier | c1 != c2 implies c1.cid != c2.cid;
    invariant UniqueMids : all m1, m2 : Method | m1 != m2 implies m1.mid != m2.mid;
    invariant UniqueAids : all a1, a2 : Attribute | a1 != a2 implies a1.aid != a2.aid;

    -- O-02: Exclusive Declaration Ownership (metamodel.als: ExclusiveDeclarationOwnership)
    invariant ExclusiveMethodOwner : all m : Method | one c : Classifier | m in c.localMethods;
    invariant ExclusiveAttributeOwner : all a : Attribute | one c : Classifier | a in c.localAttributes;

    -- O-03: Acyclic Inheritance (metamodel.als: AcyclicGeneralization)
    -- Uses classParent (mirrors metamodel.als)
    invariant AcyclicGeneralization : no c : Classifier | c in c.^classParent;

    -- O-04: Inherited Method View (metamodel.als: InheritedMethodView)
    -- Full: visibility filter, local override, nearer-ancestor priority
    invariant InheritedMethodView : all c : Classifier |
        c.inheritedMethods = {m : Method | some anc : c.^(classParent) |
            m in anc.localMethods and m.visibility != Priv and
            not (some lm : c.localMethods | lm.memberName = m.memberName and lm.paramTypes = m.paramTypes) and
            not (some nearer : c.^(classParent) |
                anc in nearer.^(classParent) and
                some rep : nearer.localMethods |
                    rep.visibility != Priv and
                    rep.memberName = m.memberName and rep.paramTypes = m.paramTypes)
        };

    -- O-04: Inherited Attribute View (metamodel.als: InheritedAttributeView)
    invariant InheritedAttributeView : all c : Classifier |
        c.inheritedAttributes = {a : Attribute | some anc : c.^(classParent) |
            a in anc.localAttributes and a.visibility != Priv and
            not (some la : c.localAttributes | la.memberName = a.memberName) and
            not (some nearer : c.^(classParent) |
                anc in nearer.^(classParent) and
                some rep : nearer.localAttributes |
                    rep.visibility != Priv and rep.memberName = a.memberName)
        };

    -- O-05: Local/Inherited Disjointness (metamodel.als: LocalInheritedSeparation)
    invariant DisjointMethods : all c : Classifier | no c.localMethods & c.inheritedMethods;
    invariant DisjointAttributes : all c : Classifier | no c.localAttributes & c.inheritedAttributes;

    -- O-08: Namespace (metamodel.als: LocalNamespaces, InheritedConflictPolicy)
    invariant LocalMethodNamespace : all c : Classifier | all m1, m2 : c.localMethods |
        m1 != m2 implies (m1.memberName != m2.memberName or m1.paramTypes != m2.paramTypes);
    invariant LocalAttributeNamespace : all c : Classifier | all a1, a2 : c.localAttributes |
        a1 != a2 implies a1.memberName != a2.memberName;
    invariant InheritedMethodNoConflict : all c : Classifier | all m1, m2 : c.inheritedMethods |
        m1 != m2 implies (m1.memberName != m2.memberName or m1.paramTypes != m2.paramTypes);
    invariant InheritedAttributeNoConflict : all c : Classifier | all a1, a2 : c.inheritedAttributes |
        a1 != a2 implies a1.memberName != a2.memberName;

    -- O-06: Implementation Binding (metamodel.als: ImplementationBindingPolicy, full 5 constraints)
    invariant BindingTargetValid : all b : ImplementationBinding |
        b.target in b.implementer.localMethods + b.implementer.inheritedMethods;
    invariant NoOrphanBodies : all mb : MethodBody | one b : ImplementationBinding | b.body = mb;
    invariant SingleBinding : all c : Classifier | all m : Method |
        lone b : ImplementationBinding | b.implementer = c and b.target = m;
    invariant AbstractNoLocal : all c : Classifier | all m : c.localMethods |
        m.isAbstract = Yes implies no b : ImplementationBinding | b.implementer = c and b.target = m;
    invariant NonAbstractHasBinding : all c : Classifier | all m : c.localMethods |
        m.isAbstract = No implies one b : ImplementationBinding | b.implementer = c and b.target = m;

    -- O-07: Abstraction (metamodel.als: AbstractionPolicy, DirectInstancePolicy, StaticMethodPolicy)
    invariant UnresolvedImpliesAbstract : all c : Classifier |
        (some m : c.localMethods + c.inheritedMethods |
            no b : ImplementationBinding |
                b.target = m and
                b.implementer in c.*(classParent))
        implies c.isAbstract = Yes;
    invariant NonAbstractHasNoUnresolved : all c : Classifier |
        c.isAbstract = No implies
            no m : c.localMethods + c.inheritedMethods |
                no b : ImplementationBinding |
                    b.target = m and
                    b.implementer in c.*(classParent);
    invariant AbstractNoDirectInstances : all c : Classifier | c.isAbstract = Yes implies no c.directInstances;
    invariant ObjectsInOneClass : all o : Object | one c : Classifier | o in c.directInstances;
    invariant StaticNotAbstract : all m : Method | not (m.scope = Static and m.isAbstract = Yes);

    -- O-09: Override Discipline (metamodel.als: OverridePolicy)
    -- Without full Type hierarchy, return-type covariance is encoded as a structural constraint
    -- using the isSubtype surrogate through the classParent chain.
    invariant OverrideReturnCompatible : all c : Classifier | all inherited, local : Method |
        local in c.localMethods and
        inherited.visibility != Priv and
        inherited.scope = local.scope and
        local.memberName = inherited.memberName and
        local.paramTypes = inherited.paramTypes and
        inherited in ((c.^(classParent)).localMethods)
    implies (local.returnType = inherited.returnType);
    invariant OverrideAbstractOrImplemented : all c : Classifier | all inherited, local : Method |
        local in c.localMethods and
        inherited.visibility != Priv and
        inherited.scope = local.scope and
        local.memberName = inherited.memberName and
        local.paramTypes = inherited.paramTypes and
        inherited in ((c.^(classParent)).localMethods)
    implies (local.isAbstract = Yes or
             some b : ImplementationBinding | b.implementer = c and b.target = local);
}