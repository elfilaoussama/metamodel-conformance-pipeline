-- Default ClassHierarchies metamodel for AlloyInEcore verification
-- Defines structural invariants for Java class hierarchies

metamodel ClassHierarchies {

    abstract class NamedElement {
        attribute name: String
    }

    class Type extends NamedElement {
        attribute abstract: Boolean
        attribute final: Boolean
        attribute visibility: String
        attribute sourcePosition: String
    }

    class Class extends Type {
        reference superclass: Class[0..1]
        reference interfaces: Interface[0..*]
        reference fields: Field[0..*]
        reference methods: Method[0..*]
    }

    class Interface extends Type {
        reference methods: Method[0..*]
    }

    class Field extends NamedElement {
        attribute type: String
        attribute visibility: String
        attribute static: Boolean
        attribute final: Boolean
    }

    class Method extends NamedElement {
        attribute returnType: String
        attribute visibility: String
        attribute static: Boolean
        attribute abstract: Boolean
        attribute parameters: Parameter[0..*]
    }

    class Parameter extends NamedElement {
        attribute type: String
    }

    invariant NoCyclicInheritance {
        -- No class can be its own ancestor
        not some c: Class | c in c.^superclass
    }

    invariant NoDuplicateTypeNames {
        -- Type names must be unique within a package
        all t1, t2: Type {
            t1.name = t2.name implies t1 = t2
        }
    }

    invariant AbstractMethodInAbstractClass {
        -- Only abstract classes can contain abstract methods
        all m: Method {
            m.abstract = true implies
            m.~methods.abstract = true
        }
    }

    invariant InterfaceMethodsAreAbstract {
        -- All methods in an interface are abstract
        all m: Method {
            m in Interface.methods implies m.abstract = true
        }
    }
}
