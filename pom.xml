<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.metamodel</groupId>
    <artifactId>metamodel-conformance-pipeline</artifactId>
    <version>0.3.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Metamodel Conformance Pipeline</name>
    <description>Pipeline for evaluating empirical correspondence of structural conditions against production object oriented codebases across Java, Python, and C++.</description>

    <modules>
        <module>modules/analysis-core</module>
        <module>modules/github-ingestion</module>
        <module>modules/github-search</module>
        <module>modules/spoon-extraction</module>
        <module>modules/python-extraction</module>
        <module>modules/cpp-extraction</module>
        <module>modules/verification-integration</module>
        <module>apps/swing-desktop</module>
    </modules>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <junit.version>5.11.4</junit.version>
        <gson.version>2.11.0</gson.version>
        <spoon.version>11.3.0</spoon.version>
        <jgit.version>7.1.0.202411261347-r</jgit.version>
        <slf4j.version>2.0.16</slf4j.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.javapipeline</groupId>
                <artifactId>analysis-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.javapipeline</groupId>
                <artifactId>github-ingestion</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.javapipeline</groupId>
                <artifactId>github-search</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.javapipeline</groupId>
                <artifactId>spoon-extraction</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.javapipeline</groupId>
                <artifactId>python-extraction</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.javapipeline</groupId>
                <artifactId>cpp-extraction</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.javapipeline</groupId>
                <artifactId>verification-integration</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                    <configuration>
                        <useModulePath>false</useModulePath>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
