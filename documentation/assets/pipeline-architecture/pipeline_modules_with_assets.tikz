% Pipeline figure using external logo assets for GitHub, Java, Python, and C++.
\begin{tikzpicture}[
 x=1cm, y=1cm, >=Stealth, line cap=round, line join=round,
 sys/.style={draw=black!88,line width=.84pt,dash pattern=on 5.8pt off 3.4pt},
 mod/.style={draw=black!68,line width=.57pt,dash pattern=on 3.3pt off 2.5pt},
 modrect/.style={mod,rounded corners=.10cm},
 modulehead/.style={font=\small\sffamily\bfseries,fill=white,inner xsep=3pt,inner ysep=1.3pt},
 systitle/.style={font=\normalsize\sffamily\bfseries,fill=white,inner xsep=5pt},
 proc/.style={draw=black!83,line width=.57pt,rounded corners=1.6pt,fill=white,
  font=\small\sffamily,align=center,inner xsep=5pt,inner ysep=3.3pt,
  minimum height=.52cm},
 fact/.style={ellipse,draw=black!81,line width=.57pt,fill=white,
  font=\small\sffamily,inner xsep=6pt,inner ysep=3pt,minimum height=.48cm},
 fdoc/.style={tape,tape bend top=none,tape bend bottom=in and out,
  draw=black!78,line width=.57pt,fill=black!3,
  font=\small\ttfamily,align=center,inner xsep=6pt,inner ysep=4pt,
  minimum height=.56cm},
 model/.style={cylinder,shape border rotate=90,aspect=.22,draw=black!82,
  line width=.60pt,fill=white,font=\small\sffamily,
  minimum height=.65cm,inner xsep=7pt,inner ysep=4pt},
 gate/.style={diamond,aspect=1.85,draw=black!85,line width=.69pt,
  fill=white,font=\small\sffamily,align=center,inner sep=1.6pt,
  minimum width=1.60cm,minimum height=.95cm},
 edge/.style={-{Stealth[length=4.3pt,width=3.1pt]},draw=black!88,line width=.67pt},
 wire/.style={draw=black!78,line width=.59pt},
 annotation/.style={font=\footnotesize\sffamily,fill=white,inner sep=1pt},
]
% system boundary
\draw[sys] (0,0) rectangle (19.9,12.86);
\node[systitle,anchor=west] at (.49,12.86) {Metamodel conformance pipeline};

% SOURCE -- compact horizontal module at top centre
\draw[modrect] (5.80,11.04) rectangle (12.65,12.21);
\node[modulehead] at (9.10,12.20) {Source / build context};
\node[inner sep=0pt] (github) at (6.64,11.61) {\includegraphics[height=.62cm]{assets/github_logo.png}};
\node[proc,minimum width=2.20cm] (context) at (9.12,11.61) {Revision / build};
\node[proc,minimum width=1.64cm] (provider) at (11.58,11.61) {Provider};
\draw[edge] (github.east) -- (context.west);
\draw[edge] (context.east) -- (provider.west);

% OBSERVERS -- vertical module on the left
\draw[modrect] (.80,4.54) rectangle (5.66,10.59);
\node[modulehead] at (3.23,10.56) {Language observers};
\node[proc,minimum width=1.60cm] (dispatch) at (3.22,9.77) {Dispatch};
\node[inner sep=0pt] (java) at (1.82,8.54) {\includegraphics[height=1.08cm]{assets/java_logo.png}};
\node[proc,minimum width=1.92cm] (spoon) at (3.82,8.54) {Spoon / javac};
\node[inner sep=0pt] (python) at (1.82,7.02) {\includegraphics[height=.95cm]{assets/python_logo.png}};
\node[proc,minimum width=1.92cm] (ast) at (3.82,7.02) {Python AST};
\node[inner sep=0pt] (cpp) at (1.82,5.50) {\includegraphics[height=.95cm]{assets/cpp_logo.png}};
\node[proc,minimum width=1.92cm] (clang) at (3.82,5.50) {Clang / TU};
\draw[edge] (java.east) -- (spoon.west);
\draw[edge] (python.east) -- (ast.west);
\draw[edge] (cpp.east) -- (clang.west);
\draw[wire] (dispatch.west) -- (1.08,9.77) -- (1.08,5.50);
\foreach \n/\yy in {java/8.54,python/7.02,cpp/5.50}{\draw[edge] (1.08,\yy) -- (\n.west);}
\draw[wire] (spoon.east) -- (5.27,8.54) -- (5.27,5.50);
\draw[wire] (ast.east) -- (5.27,7.02);
\draw[wire] (clang.east) -- (5.27,5.50);
\fill[black] (5.27,7.02) circle[radius=.035cm];
\draw[wire] (provider.south) -- (11.58,10.82) -- (.47,10.82) -- (.47,9.77);
\draw[edge] (.47,9.77) -- (dispatch.west);

% CIRCULAR CENTER: normalization and shared model
\draw[mod] (9.18,8.03) circle[radius=2.39cm];
\node[modulehead] at (9.18,10.13) {Shared observation};
\node[proc,minimum width=1.74cm] (normalize) at (8.01,8.18) {Normalize};
\node[model,minimum width=1.88cm] (emf) at (10.26,8.18) {EMF / Ecore};
\node[fdoc,minimum width=2.46cm] (xmi) at (9.18,6.79) {observation.xmi};
\draw[edge] (normalize.east) -- (emf.west);
\draw[edge] (emf.south) -- (10.26,7.56) -- (9.18,7.56) -- (xmi.north);
\draw[edge] (5.27,8.18) -- (normalize.west);

% INVARIANT PROFILE
\draw[modrect] (13.36,10.24) rectangle (19.38,12.20);
\node[modulehead] at (16.24,12.19) {Invariant profile};
\node[fdoc,minimum width=2.10cm] (registry) at (14.80,11.48) {registry.json};
\node[fdoc,minimum width=2.18cm] (rules) at (17.77,11.48) {invariants.als};
\node[proc,minimum width=1.94cm] (qualified) at (16.24,10.61) {Rule profile};
\draw[wire] (registry.south) |- (16.24,10.99);
\draw[wire] (rules.south) |- (16.24,10.99);
\draw[edge] (16.24,10.99) -- (qualified.north);

% FORMAL VERIFICATION
\draw[modrect] (13.46,3.32) rectangle (19.38,9.91);
\node[modulehead] at (16.30,9.88) {Formal verification};
\node[proc,minimum width=2.36cm] (encoder) at (15.85,8.78) {Exact encoder};
\node[fdoc,minimum width=3.00cm] (instance) at (15.85,7.63) {repository-instance.als};
\node[proc,minimum width=1.58cm] (planner) at (14.65,6.20) {Work units};
\node[fact,minimum width=1.98cm] (alloy) at (17.38,6.20) {Alloy / SAT4J};
\node[fdoc,font=\small\sffamily,minimum width=2.48cm] (decisions) at (16.20,4.55) {Decisions / witnesses};
\draw[edge] (encoder.south) -- (instance.north);
\draw[edge] (instance.south) -- (15.85,6.87) -- (14.87,6.87) -- (planner.north);
\draw[edge] (planner.east) -- (alloy.west);
\draw[edge] (alloy.south) -- (17.38,5.53) -- (18.57,5.53) -- (18.57,4.55) -- (decisions.east);
\draw[wire] (xmi.east) -- (12.62,6.79) -- (12.62,8.78);
\draw[edge] (12.62,8.78) -- (encoder.west);
\draw[wire] (qualified.east) -- (18.62,10.61) -- (18.62,8.78);
\draw[edge] (18.62,8.78) -- (encoder.east);
\draw[wire] (18.62,8.78) -- (18.62,6.80) -- (17.38,6.80);
\draw[edge] (17.38,6.80) -- (alloy.north);

% ADMISSION
\draw[modrect] (7.04,3.08) rectangle (12.09,5.26);
\node[modulehead] at (9.46,5.26) {Evidence admission};
\node[fact,minimum width=1.52cm] (evkind) at (8.08,4.47) {Evidence};
\node[gate] (admissible) at (10.38,4.48) {Ready?};
\node[fact,minimum width=2.15cm] (unknown) at (9.63,3.52) {NOT\_EVALUATED};
\draw[edge] (evkind.east) -- (admissible.west);
\draw[edge] (admissible.south) -- node[annotation,left,pos=.20] {no} (unknown.north);
\draw[wire] (xmi.south) -- (9.18,5.54) -- (6.79,5.54) -- (6.79,4.47);
\draw[edge] (6.79,4.47) -- (evkind.west);
\draw[wire] (admissible.east) -- (12.96,4.48) -- (12.96,6.20);
\draw[edge] (12.96,6.20) -- node[annotation,above,pos=.48] {yes} (planner.west);
\draw[wire] (unknown.east) -- (12.37,3.54) -- (12.37,3.25) -- (13.23,3.25) -- (13.23,4.55);
\draw[edge] (13.23,4.55) -- (decisions.west);

% REPLAY
\draw[modrect] (.80,.65) rectangle (6.00,2.75);
\node[modulehead] at (3.40,2.75) {Independent replay};
\node[proc,minimum width=2.24cm] (verifier) at (3.40,1.84) {Capsule verifier};
\node[fact,minimum width=2.12cm] (replay) at (3.40,1.08) {Replay status};
\draw[edge] (verifier.south) -- (replay.north);

% RETENTION
\draw[modrect] (6.65,.65) rectangle (19.38,2.75);
\node[modulehead,anchor=west] at (7.35,2.75) {Retained research artifacts};
\node[fdoc,font=\small\sffamily,minimum width=2.65cm] (capsule) at (8.35,1.70) {Verification capsule};
\node[proc,minimum width=2.20cm] (writer) at (11.74,1.70) {Capsule writer};
\node[model,minimum width=2.96cm] (bundle) at (16.12,1.70) {XMI / Alloy / decisions};
\draw[edge] (bundle.west) -- (writer.east);
\draw[edge] (writer.west) -- (capsule.east);
\draw[wire] (decisions.south) -- (16.20,2.96) -- (16.12,2.96);
\draw[edge] (16.12,2.96) -- (bundle.north);
\draw[edge] (capsule.west) -- (verifier.east);
\end{tikzpicture}