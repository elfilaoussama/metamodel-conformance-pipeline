% Publication-oriented, asset-free architecture diagram.
% All original component-level relations are retained. A join dot means
% connectivity; a white-halo crossing means no connection. A status fan-out
% denotes alternative outcomes, not simultaneous execution.
% Cylinders denote structured representations / collections, NOT databases.
\definecolor{ink}{RGB}{40,48,56}
\definecolor{boundary}{RGB}{132,143,153}
\definecolor{paperblue}{RGB}{239,245,250}
\definecolor{papergreen}{RGB}{237,246,243}
\definecolor{passfill}{RGB}{234,244,236}
\definecolor{failfill}{RGB}{249,236,233}
\definecolor{waitfill}{RGB}{249,245,229}
\begin{tikzpicture}[x=1cm,y=1cm,font=\sffamily\fontsize{12}{14}\selectfont,
 line cap=round,line join=round,text=ink,
 system/.style={draw=ink,line width=.85pt,dash pattern=on 7pt off 4pt},
 module/.style={draw=boundary,line width=.65pt,dash pattern=on 4pt off 3pt},
 heading/.style={font=\sffamily\bfseries\fontsize{12}{14}\selectfont,fill=white,inner xsep=6pt,inner ysep=2pt},
 op/.style={rectangle,draw=ink,fill=white,line width=.7pt,align=center,minimum height=.76cm,inner xsep=8pt,inner ysep=4pt},
 file/.style={tape,tape bend top=none,tape bend bottom=in and out,draw=ink,fill=paperblue,line width=.7pt,font=\ttfamily\fontsize{11}{13}\selectfont,align=center,minimum height=.78cm,inner xsep=8pt,inner ysep=5pt},
 store/.style={cylinder,shape border rotate=90,aspect=.18,draw=ink,fill=papergreen,line width=.7pt,align=center,minimum height=.92cm,inner xsep=8pt,inner ysep=5pt},
 gate/.style={diamond,aspect=1.8,draw=ink,fill=waitfill,line width=.7pt,align=center,minimum width=1.65cm,minimum height=1.08cm,inner sep=2pt},
 status/.style={rectangle,rounded corners=9pt,draw=ink,line width=.7pt,font=\ttfamily\fontsize{11}{13}\selectfont,minimum height=.66cm,inner xsep=9pt,align=center},
 flow/.style={draw=ink,line width=.85pt,-{Stealth[length=5pt,width=3.7pt]}},
 wire/.style={draw=ink,line width=.85pt},
 dep/.style={draw=boundary,line width=.9pt,densely dotted,-{Stealth[length=4.7pt,width=3.5pt]}},
 halo/.style={preaction={draw=white,line width=4.8pt}},
 label/.style={font=\sffamily\fontsize{10}{12}\selectfont,fill=white,inner sep=2pt}
]
% -------------------- System and module boundaries --------------------
\draw[system] (0,0) rectangle (30,17);
% Figure title removed; provide it in the manuscript caption.
\draw[module] (.65,13.25) rectangle (11.45,16.25);
\node[heading,anchor=west] at (.95,16.25) {Source / build context};
\draw[module] (.65,6.35) rectangle (6.0,12.15);
\node[heading,anchor=west] at (.95,12.15) {Language observers};
\draw[module] (8.9,9.25) circle[radius=2.55cm];
\node[heading] at (8.9,11.80) {Shared observation};
\draw[module] (18.85,13.25) rectangle (29.25,16.25);
\node[heading,anchor=west] at (19.15,16.25) {Invariant profile};
\draw[module] (12.55,5.65) rectangle (18.50,9.25);
\node[heading,anchor=west] at (12.85,9.25) {Evidence admission};
\draw[module] (19.15,3.25) rectangle (29.25,12.15);
\node[heading,anchor=west] at (19.45,12.15) {Formal verification};
\draw[module] (7.10,.55) rectangle (29.25,2.35);
\node[heading,anchor=west] at (7.40,2.35) {Verification Artifacts};
\draw[module] (.65,.55) rectangle (6.25,4.50);
\node[heading,anchor=west] at (.95,4.50) {Formal Replay};

% -------------------- Operations, data, and status nodes --------------------
\node[op,minimum width=3.20cm] (context) at (5.10,14.65) {Revision / build};
\node[inner sep=0pt] (github) at (1.65,14.65) {\includegraphics[height=0.775cm]{assets/github_logo.png}};
\node[op,minimum width=2.70cm] (provider) at (9.20,14.65) {Provider};
\node[op,minimum width=2.55cm] (dispatch) at (3.05,11.15) {Dispatch};
\node[op,minimum width=3.65cm] (spoon) at (3.46,9.65) {\raisebox{-0.18em}{\includegraphics[height=0.42cm]{assets/java_logo.png}}\hspace{0.35em}Spoon / javac};
\node[op,minimum width=3.65cm] (pythonobs) at (3.46,8.35) {\raisebox{-0.18em}{\includegraphics[height=0.42cm]{assets/python_logo.png}}\hspace{0.35em}Python AST};
\node[op,minimum width=3.65cm] (clang) at (3.46,7.05) {\raisebox{-0.18em}{\includegraphics[height=0.42cm]{assets/cpp_logo.png}}\hspace{0.35em}Clang / TU};
\node[op,minimum width=2.80cm] (norm) at (8.90,10.75) {Normalize};
\node[store,minimum width=3.00cm] (emf) at (8.90,9.20) {EMF / Ecore};
\node[file,minimum width=3.70cm] (xmi) at (8.90,7.85) {observation.xmi};
\node[file,minimum width=3.60cm] (registry) at (21.55,15.25) {registry.json};
\node[file,minimum width=3.60cm] (invariants) at (26.25,15.25) {invariants.als};
\node[op,minimum width=3.0cm] (profile) at (23.90,13.95) {Rule profile};
\node[op,minimum width=3.30cm] (encoder) at (22.10,11.15) {Exact encoder};
\node[file,minimum width=5.10cm] (instance) at (22.10,9.85) {repository-instance.als};
\node[op,minimum width=2.65cm] (planner) at (21.30,7.85) {Work units};
\node[op,minimum width=3.00cm] (solver) at (26.00,7.85) {Alloy / SAT4J};
\node[op,minimum width=2.25cm] (evidence) at (14.15,7.85) {Evidence};
\node[gate] (ready) at (16.90,7.85) {Ready?};
\node[status,fill=waitfill,minimum width=3.70cm] (notEval) at (15.60,6.35) {NOT\_EVALUATED};
\node[status,fill=passfill,minimum width=3.10cm] (conformant) at (21.30,5.60) {CONFORMANT};
\node[status,fill=failfill,minimum width=3.90cm] (nonconformant) at (26.00,5.60) {NON\_CONFORMANT};
\node[op,minimum width=4.25cm] (decisions) at (23.25,3.95) {Decisions / witnesses};
\node[store,minimum width=3.60cm] (bundle) at (23.25,1.40) {Artifacts};
\node[op,minimum width=3.40cm] (writer) at (17.30,1.40) {Capsule writer};
\node[file,minimum width=4.00cm,font=\sffamily\fontsize{12}{14}\selectfont] (capsule) at (11.20,1.40) {Verification capsule};
\node[op,minimum width=3.80cm] (verifier) at (3.45,3.00) {Capsule verifier};
\node[status,fill=white,font=\sffamily\fontsize{12}{14}\selectfont,minimum width=3.20cm] (replay) at (3.45,1.40) {Replay status};

% -------------------- Source / observers / shared representation --------------------
% GitHub precedes revision/build and the source provider; these are separate steps.
\draw[flow] (github.east) -- (context.west);
\draw[flow] (context.east) -- (provider.west);
% Provider enters Dispatch from the right to avoid the observer-module heading.
\draw[flow] (provider.south) -- (9.20,12.65) -- (5.65,12.65) -- (5.65,11.15) -- (dispatch.east);
% Actual Dispatch fan-out: output goes DOWN from Dispatch, then left to a rail.
% Rail is left of all three language-processing boxes, so each arrow goes RIGHT.
\draw[flow] (dispatch.south) -- (3.05,10.36);
\draw[wire] (3.05,10.36) -- (.99,10.36) -- (.99,7.05);
\foreach \n/\yy in {spoon/9.65,pythonobs/8.35,clang/7.05}{
 \draw[flow] (.99,\yy) -- (\n.west);
 \draw[wire] (\n.east) -- (5.65,\yy);
}
% Merge observed facts into the normalization input. Explicit join points.
\draw[wire] (5.65,7.05) -- (5.65,10.75);
\draw[flow] (5.65,10.75) -- (norm.west);
\foreach \yy in {9.65,8.35}{\fill[ink] (5.65,\yy) circle[radius=1.35pt];}
\draw[flow] (norm.south) -- (emf.north);
\draw[flow] (emf.south) -- (xmi.north);

% -------------------- Profile inputs and constraints --------------------
\draw[wire] (registry.south) -- (21.55,14.60) -- (26.25,14.60) -- (invariants.south);
\fill[ink] (23.90,14.60) circle[radius=1.35pt];
\draw[flow] (23.90,14.60) -- (profile.north);
\draw[wire] (profile.south) -- (23.90,12.65) -- (27.95,12.65) -- (27.95,8.70) -- (26.00,8.70);
\draw[flow] (26.00,8.70) -- (solver.north);
\draw[flow] (27.95,11.15) -- (encoder.east);
\fill[ink] (27.95,11.15) circle[radius=1.35pt];
% Profile-to-admission dependency occupies a separate upper routing lane.
\draw[dep] (profile.west) -- (16.90,13.95) -- (16.90,10.15) -- (16.90,9.00) -- (ready.north);
\node[label,anchor=south east] at (16.75,12.65) {evidence requirements};

% -------------------- Observation fan-out --------------------
\draw[wire] (xmi.east) -- (11.90,7.85) -- (11.90,11.15);
% White halo makes the dependency crossing unambiguously non-connecting.
\draw[flow,halo] (11.90,11.15) -- (encoder.west);
\draw[flow] (11.90,7.85) -- (evidence.west);
\fill[ink] (11.90,7.85) circle[radius=1.35pt];
\draw[flow] (evidence.east) -- (ready.west);
\draw[flow] (ready.east) -- (planner.west);
\node[label,anchor=south] at (18.70,7.95) {yes};
\draw[flow] (ready.south) -- (16.90,6.95) -- (15.60,6.95) -- (notEval.north);
\node[label,anchor=west] at (16.95,7.10) {no};

% -------------------- Exact encoding, work planning, solving --------------------
\draw[flow] (encoder.south) -- (instance.north);
\draw[flow] (instance.south) -- (22.10,8.85) -- (21.30,8.85) -- (planner.north);
\draw[flow] (planner.east) -- (solver.west);
\draw[wire] (solver.south) -- (26.00,6.65) -- (21.30,6.65);
\draw[flow] (21.30,6.65) -- (conformant.north);
\draw[flow] (26.00,6.65) -- (nonconformant.north);
\fill[ink] (26.00,6.65) circle[radius=1.35pt];
\node[label] at (23.55,6.65) {assessment outcome};
\draw[wire] (conformant.south) -- (21.30,4.80) -- (26.00,4.80) -- (nonconformant.south);
\draw[flow] (23.25,4.80) -- (decisions.north);
\fill[ink] (23.25,4.80) circle[radius=1.35pt];
\draw[flow] (notEval.east) -- (18.75,6.35) -- (18.75,3.95) -- (decisions.west);

% -------------------- Retention and independent replay --------------------
% Observation, generated instance and decisions join the provenance bus.
\draw[wire] (xmi.south) -- (8.90,2.80) -- (28.70,2.80);
% The instance crosses the profile constraint feed, but does not join it.
\draw[wire,halo] (instance.east) -- (28.70,9.85);
\draw[wire] (28.70,9.85) -- (28.70,2.80);
\draw[wire] (decisions.south) -- (23.25,2.80);
\fill[ink] (23.25,2.80) circle[radius=1.45pt];
\draw[flow] (23.25,2.80) -- (bundle.north);
\draw[flow] (bundle.west) -- (writer.east);
\draw[flow] (writer.west) -- (capsule.east);
\draw[flow] (capsule.west) -- (6.65,1.40) -- (6.65,3.00) -- (verifier.east);
\draw[flow] (verifier.south) -- (replay.north);

% -------------------- Compact key: no new architectural components --------------------
\draw[flow] (.70,-.60) -- (1.70,-.60);
\node[label,anchor=west] at (1.85,-.60) {execution / data flow};
\draw[dep] (7.80,-.60) -- (8.80,-.60);
\node[label,anchor=west] at (8.95,-.60) {dependency};
\draw[wire] (13.10,-.60) -- (14.10,-.60);
\fill[ink] (13.60,-.60) circle[radius=1.4pt];
\node[label,anchor=west] at (14.25,-.60) {connected junction};
\draw[wire] (20.40,-.85) -- (20.40,-.35);
\draw[wire,halo] (19.90,-.60) -- (20.90,-.60);
\node[label,anchor=west] at (21.05,-.60) {crossing: no connection};
\end{tikzpicture}
