% Research architecture of the EMF/XMI-to-Alloy metamodel conformance pipeline.
% Labels reflect the November 2026 pipeline. Not an experimental result figure.
% Dashed system boundary; dashed modules (vertical/horizontal rectangular + centered circular).
% Processing in rectangles; files as document symbols; persisted bundle as cylinder; states as ovals.
% Full supplied logos identify observers, not intermediate processing steps.
\begin{tikzpicture}[
 x=1cm,y=1cm,>=Stealth,line join=round,line cap=round,
 sys/.style={draw=black!88,line width=.85pt,dash pattern=on 6pt off 3.5pt},
 module/.style={draw=black!66,line width=.58pt,dash pattern=on 3pt off 2.5pt},
 mb/.style={module,rounded corners=.10cm},
 mh/.style={font=\small\sffamily\bfseries,inner xsep=3pt,inner ysep=1pt,fill=white},
 title/.style={font=\normalsize\sffamily\bfseries,inner xsep=5pt,fill=white},
 proc/.style={rectangle,draw=black!84,line width=.59pt,rounded corners=1.1pt,fill=white,inner xsep=6pt,inner ysep=4pt,minimum height=.61cm,font=\small\sffamily,align=center},
 sourcefile/.style={tape,tape bend top=none,tape bend bottom=in and out,draw=black!77,line width=.58pt,fill=white,font=\small\ttfamily,inner xsep=6pt,inner ysep=4pt,minimum height=.58cm,align=center},
 db/.style={cylinder,shape border rotate=90,aspect=.19,draw=black!80,line width=.6pt,fill=white,inner xsep=7pt,inner ysep=4pt,minimum height=.72cm,font=\small\sffamily,align=center},
 state/.style={ellipse,draw=black!83,line width=.57pt,fill=white,font=\small\sffamily,inner xsep=7pt,inner ysep=4pt,minimum height=.52cm,align=center},
 gate/.style={diamond,aspect=1.85,draw=black!83,line width=.62pt,fill=white,font=\small\sffamily,inner sep=2pt,minimum width=1.5cm,minimum height=.92cm,align=center},
 flow/.style={-{Stealth[length=4.3pt,width=3.2pt]},draw=black!84,line width=.63pt},
 bus/.style={draw=black!80,line width=.60pt},
 reqwire/.style={draw=black!65,line width=.55pt,dash pattern=on 2pt off 2pt},
 requires/.style={-{Stealth[length=4.1pt,width=2.7pt]},draw=black!65,line width=.55pt,dash pattern=on 2pt off 2pt},
 branchtext/.style={font=\small\sffamily,inner sep=1.7pt,fill=white},
]
% System boundary and module frames. No color backgrounds needed for print.
\draw[sys] (0,0) rectangle (20.5,13.65);
\node[title,anchor=west] at (.50,13.65) {Metamodel conformance pipeline};
\draw[mb] (.85,11.45) rectangle (6.45,13.15);
\node[mh] at (3.22,13.15) {Source / build context};
\draw[mb] (.85,5.17) rectangle (6.45,11.04);
\node[mh,anchor=west] at (1.06,11.04) {Language observers};
\draw[module] (9.90,8.08) circle[radius=2.43cm];
\node[mh] at (9.90,10.25) {Shared observation};
\draw[mb] (14.05,11.05) rectangle (19.65,13.15);
\node[mh] at (16.85,13.15) {Invariant profile};
\draw[mb] (14.05,3.11) rectangle (19.65,10.67);
\node[mh] at (16.85,10.67) {Formal verification};
\draw[mb] (7.18,3.11) rectangle (12.54,5.40);
\node[mh,anchor=west] at (7.37,5.40) {Evidence admission};
\draw[mb] (.85,.67) rectangle (6.15,2.65);
\node[mh] at (3.50,2.65) {Independent replay};
\draw[mb] (6.65,.67) rectangle (19.65,2.65);
\node[mh,anchor=west] at (7.30,2.65) {Retained research artifacts};

% Source / context — top-left, no cross-page source return.
\node[inner sep=0pt] (github) at (1.37,12.14) {\includegraphics[height=.62cm]{assets/github_logo.png}};
\node[proc,minimum width=2.17cm] (context) at (3.19,12.14) {Revision / build};
\node[proc,minimum width=1.44cm] (provider) at (5.51,12.14) {Provider};
\draw[flow] (github.east) -- (context.west);
\draw[flow] (context.east) -- (provider.west);

% Observer dispatch: a REAL one-to-three fan-out from Dispatch.
\node[proc,minimum width=1.52cm] (dispatch) at (5.34,10.12) {Dispatch};
\draw[flow] (provider.south) -- (5.51,11.24) -- (5.34,11.24) -- (dispatch.north);
\node[proc,minimum width=3.33cm,minimum height=.83cm] (spoon) at (3.85,8.83) {\hspace*{.73cm}Spoon / javac};
\node[proc,minimum width=3.33cm,minimum height=.83cm] (pythonobs) at (3.85,7.45) {\hspace*{.73cm}Python AST};
\node[proc,minimum width=3.33cm,minimum height=.83cm] (clang) at (3.85,6.07) {\hspace*{.73cm}Clang / TU};
\node[inner sep=0pt] at (2.65,8.83) {\includegraphics[height=.62cm]{assets/java_logo.png}};
\node[inner sep=0pt] at (2.65,7.45) {\includegraphics[height=.62cm]{assets/python_logo.png}};
\node[inner sep=0pt] at (2.65,6.07) {\includegraphics[height=.62cm]{assets/cpp_logo.png}};
\draw[bus] (dispatch.west) -- (1.40,10.12) -- (1.40,6.07);
\foreach \n/\y in {spoon/8.83,pythonobs/7.45,clang/6.07}{\draw[flow] (1.40,\y) -- (\n.west);}
% three tool outputs merge at an explicit output rail
\draw[bus] (spoon.east) -- (5.70,8.83) -- (5.70,6.07);
\draw[bus] (pythonobs.east) -- (5.70,7.45);
\draw[bus] (clang.east) -- (5.70,6.07);
\fill (5.70,7.45) circle[radius=.035cm];

% Shared observation core — centered on the main left-to-right path.
\node[proc,minimum width=1.68cm] (norm) at (8.65,8.20) {Normalize};
\node[db,minimum width=1.83cm] (emf) at (10.73,8.20) {EMF / Ecore};
\node[sourcefile,minimum width=2.44cm] (xmi) at (9.90,6.69) {observation.xmi};
\draw[flow] (5.70,8.20) -- (norm.west);
\draw[flow] (norm.east) -- (emf.west);
\draw[flow] (emf.south) -- (10.73,7.52) -- (9.90,7.52) -- (xmi.north);

% Two declarative source files form one registered, versioned rule profile.
\node[sourcefile,font=\fontsize{8.5pt}{10pt}\selectfont\ttfamily,minimum width=4.77cm] (rulefiles) at (16.85,12.27) {registry.json / invariants.als};
\node[proc,minimum width=2.10cm] (profile) at (16.85,11.49) {Rule profile};
\draw[flow] (rulefiles.south) -- (profile.north);

% Formal verification – exact model constructed before qualified solving.
\node[proc,minimum width=2.41cm] (encoder) at (16.38,9.53) {Exact encoder};
\node[sourcefile,minimum width=3.12cm] (instance) at (16.38,8.27) {repository-instance.als};
\node[proc,minimum width=1.74cm] (planner) at (15.52,6.37) {Work units};
\node[proc,minimum width=1.78cm] (solver) at (18.15,6.37) {Alloy / SAT4J};
\node[proc,minimum width=2.87cm] (decisions) at (16.69,4.05) {Decisions / witnesses};
\draw[flow] (encoder.south) -- (instance.north);
\draw[flow] (instance.south) -- (16.38,7.42) -- (15.52,7.42) -- (planner.north);
\draw[flow] (planner.east) -- (solver.west);
\draw[flow] (solver.south) -- (18.15,5.18) -- (18.95,5.18) -- (18.95,4.05) -- (decisions.east);
% XMI -> exact encoding via a separate upper corridor
\draw[bus] (xmi.east) -- (12.77,6.69) -- (12.77,9.53);
\draw[flow] (12.77,9.53) -- (encoder.west);
% Profile -> encoder and solver via the right-hand rail
\draw[bus] (profile.east) -- (19.12,11.49) -- (19.12,9.53);
\draw[flow] (19.12,9.53) -- (encoder.east);
\draw[bus] (19.12,9.53) -- (19.12,7.10) -- (18.15,7.10);
\draw[flow] (18.15,7.10) -- (solver.north);

% Evidence admission uses the observed facts and rule prerequisites.
\node[proc,minimum width=1.78cm] (evidence) at (8.92,4.76) {Evidence};
\node[gate] (ready) at (11.18,4.76) {Ready?};
\node[state,font=\small\ttfamily,minimum width=2.54cm] (unknown) at (10.40,3.65) {NOT\_EVALUATED};
\draw[flow] (evidence.east) -- (ready.west);
\draw[flow] (ready.south) -- (11.18,4.10) -- (10.40,4.10) -- (unknown.north);
\node[branchtext] at (11.43,4.16) {no};
% Shared observed XMI feeds admission and artifact retention.
\draw[flow] (6.77,4.76) -- (evidence.west);
\fill (6.77,4.76) circle[radius=.033cm];
% Profile prerequisite metadata: dashed, with deliberate gaps at the two data-flow crossings.
\draw[reqwire] (profile.west) -- (13.50,11.49) -- (13.50,9.70);
\draw[reqwire] (13.50,9.37) -- (13.50,6.02);
\draw[requires] (13.50,5.65) -- (13.50,5.30) -- (11.18,5.30) -- (ready.north);
% yes branch has its own lower corridor; does not share xmi-to-encoder lane
\draw[bus] (ready.east) -- (12.68,4.76) -- (12.68,5.81) -- (15.52,5.81);
\node[branchtext] at (12.27,5.00) {yes};
\draw[flow] (15.52,5.81) -- (planner.south);
% no branch bypasses the solver and feeds the decision record
\draw[bus] (unknown.east) -- (12.28,3.65) -- (12.28,4.05);
\draw[flow] (12.28,4.05) -- (decisions.west);

% Retained evidence and independently replayable capsule.
\node[db,minimum width=3.0cm] (bundle) at (16.40,1.63) {Artifacts};
\node[proc,minimum width=2.08cm] (writer) at (11.98,1.63) {Capsule writer};
\node[sourcefile,font=\small\sffamily,minimum width=2.62cm] (capsule) at (8.48,1.63) {Verification capsule};
\draw[flow] (bundle.west) -- (writer.east);
\draw[flow] (writer.west) -- (capsule.east);
\node[proc,minimum width=2.33cm] (verifier) at (4.68,1.63) {Capsule verifier};
\node[state,minimum width=2.02cm] (replay) at (2.08,1.63) {Status};
\draw[flow] (capsule.west) -- (verifier.east);
\draw[flow] (verifier.west) -- (replay.east);
% Provenance three-way bus: independently sourced XMI, encoded Alloy, recorded decisions.
\draw[bus] (xmi.west) -- (6.77,6.69) -- (6.77,2.89) -- (15.43,2.89);
\draw[bus] (instance.east) -- (19.97,8.27) -- (19.97,2.89) -- (17.45,2.89);
\draw[bus] (15.43,2.89) -- (17.45,2.89);
\draw[bus] (decisions.south) -- (16.69,2.89);
\fill (16.40,2.89) circle[radius=.035cm];
\draw[flow] (16.40,2.89) -- (bundle.north);
\end{tikzpicture}
