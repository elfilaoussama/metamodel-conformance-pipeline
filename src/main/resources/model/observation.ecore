    <eStructuralFeatures xsi:type="ecore:EReference" name="implementer" lowerBound="1" eType="#//Classifier"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="target" lowerBound="1" eType="#//Member"/>
